[Unit]
# DEV-ONLY: this host systemd deployment has no image versioning, rollback,
# or replication. The commercial/portable deploy path is the K8s manifests
# under deploy/*.yaml (see docs/DEPLOY_IN_CLUSTER.md) — do not use this unit
# as a reference for production readiness.
Description=NodeVault Control Plane (gRPC :50051 + webhook :8082) [dev-only, not the commercial deploy path]
Documentation=https://github.com/HeaInSeo/NodeVault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodevault
Group=nodevault
WorkingDirectory=/opt/nodevault

# ── 바이너리 ─────────────────────────────────────────────────────────────────
ExecStart=/opt/nodevault/bin/nodevault

# ── 포트 설정 ─────────────────────────────────────────────────────────────────
Environment=NODEVAULT_ADDR=:50051
Environment=NODEVAULT_WEBHOOK_ADDR=:8082

# ── K8s 클러스터 연결 (L3 dry-run / L4 smoke run 필요) ────────────────────────
Environment=KUBECONFIG=/opt/nodevault/kubeconfig

# ── Harbor 레지스트리 주소 ────────────────────────────────────────────────────
# harbor.lab.local is the standard hostname since Sprint 5 (2026-07-12) — see
# pkg/registryconfig.DefaultAddr and deploy/03-nodevault.yaml. The old raw
# nip.io address has no CA trust entry on this host
# (/etc/containers/certs.d/harbor.lab.local/ca.crt exists; a nip.io one does
# not) and no /etc/hosts entry, so pushes to it fail the TLS handshake and
# fall back to a plain-HTTP attempt on :80, which times out against the
# HTTPS-only Cilium Gateway.
Environment=NODEVAULT_REGISTRY_ADDR=harbor.lab.local

# ── Harbor push 인증 ─────────────────────────────────────────────────────────
# pkg/registryconfig's default auth file path (/run/containers/0/auth.json)
# assumes UID 0; this unit runs as the unprivileged nodevault user (UID 975),
# so that default never matched anything here and pushes failed with
# "unauthorized" even after the registry address fix above. auth.json is
# provisioned out-of-band at /opt/nodevault/auth.json (0600, owned by
# nodevault:nodevault) from infra-lab's Harbor admin credentials — not
# checked into this repo.
Environment=REGISTRY_AUTH_FILE=/opt/nodevault/auth.json

# ── reconcile 간격 (기본: fast=5m, slow=30m / 테스트 시 단축 가능) ──────────
Environment=NODEVAULT_FAST_RECONCILE=30s
Environment=NODEVAULT_SLOW_RECONCILE=10m

# ── podbridge5 rootless 컨테이너 빌드 스토리지 ───────────────────────────────
# systemd가 /run/nodevault 를 nodevault 소유로 생성 → XDG_RUNTIME_DIR로 사용
# (ReexecIfNeeded()가 libpod 디렉토리를 XDG_RUNTIME_DIR 하위에 만든다)
#
# CONTAINERS_STORAGE_CONF는 필수다: /etc/containers/storage.conf(호스트 전역)의
# runroot("/run/containers/storage")는 root 전용이고, containers/storage는
# podbridge5의 user-namespace 재실행 이후 EUID 0으로 보이는 시점에 XDG_RUNTIME_DIR을
# 무시한 채 이 전역 경로를 그대로 시도한다 — nodevault 계정은 여기 쓸 수 없어
# "mkdir /run/containers/storage: permission denied"로 기동 자체가 실패한다.
# CONTAINERS_STORAGE_CONF는 EUID 판단을 거치지 않고 무조건 지정한 파일을 읽으므로
# 호스트 전역 설정(다른 워크로드도 공유)을 건드리지 않고 이 서비스만 격리해서
# 고칠 수 있다 — K8s 배포(deploy/03-nodevault.yaml의 nodevault-containers-storage
# ConfigMap)와 동일한 패턴.
RuntimeDirectory=nodevault
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/nodevault
Environment=CONTAINERS_STORAGE_CONF=/opt/nodevault/storage.conf

# ── assets/ 경로 (index, catalog, policy) ────────────────────────────────────
Environment=INDEX_DIR=/opt/nodevault/assets/index
Environment=CATALOG_DIR=/opt/nodevault/assets/catalog
Environment=DATA_CATALOG_DIR=/opt/nodevault/assets/datacatalog

# ── 재시작 정책 ───────────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5s

# ── 로그 ──────────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nodevault

[Install]
WantedBy=multi-user.target
